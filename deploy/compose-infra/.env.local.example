# 本文件只定义本地开发所需的变量名称和示例值。
# 不要直接用于生产，不要在这里填写真实生产密码。

# Compose 端口只绑定本机，避免局域网或公网访问中间件。
INFRA_BIND_HOST=127.0.0.1

MINIPAY_MYSQL_HOST_PORT=13306
MINIPAY_REDIS_HOST_PORT=16379
RABBITMQ_HOST_PORT=15673
RABBITMQ_MANAGEMENT_HOST_PORT=15672
# Legacy console variables below are unused by the Seata 2.6 coordinator.
SEATA_CONSOLE_HOST_PORT=7091
SEATA_SERVICE_HOST_PORT=8091
YSHOP_MYSQL_HOST_PORT=13307
YSHOP_REDIS_HOST_PORT=16380

# MiniPay MySQL root。
MINIPAY_MYSQL_ROOT_PASSWORD=local-change-me-minipay-root

# 每个服务使用独立数据库账号。
IDENTITY_DB_USERNAME=minipay_identity_app
IDENTITY_DB_PASSWORD=local-change-me-identity-db

PAYMENT_DB_USERNAME=minipay_payment_app
PAYMENT_DB_PASSWORD=local-change-me-payment-db

WALLET_DB_USERNAME=minipay_wallet_app
WALLET_DB_PASSWORD=local-change-me-wallet-db

COMMERCE_DB_USERNAME=minipay_commerce_app
COMMERCE_DB_PASSWORD=local-change-me-commerce-db

AGENT_DB_USERNAME=minipay_agent_app
AGENT_DB_PASSWORD=local-change-me-agent-db

# 当前 Seata 配置固定使用用户名 seata，密码仍由环境变量提供。
SEATA_DB_USERNAME=seata
SEATA_DB_PASSWORD=local-change-me-seata-db
SEATA_CONSOLE_USERNAME=seata
SEATA_CONSOLE_PASSWORD=local-change-me-seata-console
SEATA_SECRET_KEY=local-change-me-seata-signing-key-at-least-32-characters
SEATA_JVM_XMS=256m
SEATA_JVM_XMX=512m
SEATA_JVM_MAX_DIRECT_MEMORY_SIZE=256m

# MiniPay Redis。
MINIPAY_REDIS_PASSWORD=local-change-me-minipay-redis

# MiniPay 与 YShop 共用 RabbitMQ。
RABBITMQ_USERNAME=minipay
RABBITMQ_PASSWORD=local-change-me-rabbitmq

# YShop MySQL。
YSHOP_MYSQL_DATABASE=yixiang_drink
YSHOP_MYSQL_USERNAME=yshop
YSHOP_MYSQL_PASSWORD=local-change-me-yshop-db
YSHOP_MYSQL_ROOT_PASSWORD=local-change-me-yshop-root

# YShop Redis。
YSHOP_REDIS_PASSWORD=local-change-me-yshop-redis

# Coturn 当前不会默认启动，这些只是本地模板值。
TURN_BIND_HOST=127.0.0.1
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=minipay.local
TURN_SHARED_SECRET=local-change-me-turn-secret
