# Public HTTPS origins. Do not include a trailing slash.
IDENTITY_PUBLIC_URL=https://identity.example.com
MANAGEMENT_PUBLIC_URL=https://ops.example.com
ADMIN_PUBLIC_URL=https://admin.example.com
MERCHANT_PUBLIC_URL=https://merchant.example.com
FOOD_PUBLIC_ORIGIN=https://food.example.com
IDENTITY_DOMAIN=identity.example.com
PAYMENT_DOMAIN=payment.example.com
WALLET_DOMAIN=wallet.example.com
AGENT_DOMAIN=agent.example.com
COMMERCE_DOMAIN=commerce.example.com
MANAGEMENT_DOMAIN=ops.example.com
ADMIN_DOMAIN=admin.example.com
MERCHANT_DOMAIN=merchant.example.com
FOOD_DOMAIN=food.example.com

# Cross-repository locations used by the deployment wrapper.
FRONTEND_ROOT=/opt/minipay/frontend
YSHOP_ROOT=/opt/minipay/yshop
YSHOP_H5_ROOT=/opt/minipay/yshop-h5

# Real providers. Production validation rejects demo/sandbox modes.
SMS_PROVIDER=dypns
REAL_NAME_PROVIDER=aliyun
OBJECT_STORAGE_PROVIDER=aliyun
MODEL_ENABLED=true
MODEL_CHAT_MODE=openai
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_SIGN_NAME=
ALIYUN_DYPNS_TEMPLATE_CODE=100001
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_CONTENT_SAFETY_REGION=

# Public-network and key material.
TURN_URLS=turn:turn.example.com:3478?transport=udp
TURN_REALM=turn.example.com
JWT_SIGNING_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt-private.pem
JWT_SIGNING_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem
JWT_SIGNING_PRIVATE_KEY_FILE=./.secrets/jwt-private.pem
JWT_SIGNING_PUBLIC_KEY_FILE=./.secrets/jwt-public.pem

# yshop production database and integration.
RABBITMQ_USERNAME=minipay
YSHOP_MYSQL_DATABASE=yshop
YSHOP_MYSQL_USERNAME=yshop
YSHOP_MYSQL_PASSWORD=
YSHOP_MYSQL_ROOT_PASSWORD=
YSHOP_REDIS_PASSWORD=
YSHOP_MINIPAY_TENANT_ID=1
YSHOP_MINIPAY_AVATAR_ALLOWED_HOSTS=
YSHOP_MINIPAY_AMAP_WEB_KEY=

# Generated by bootstrap-server-env.sh. They are listed here to document the contract.
MYSQL_PASSWORD=
SEATA_DB_PASSWORD=
SEATA_CONSOLE_PASSWORD=
SEATA_SECRET_KEY=
RABBITMQ_PASSWORD=
MANAGEMENT_OAUTH_CLIENT_SECRET=
ADMIN_OAUTH_CLIENT_SECRET=
PHONE_HASH_PEPPER=
PHONE_DISCLOSURE_ENCRYPTION_KEY=
EMAIL_HASH_PEPPER=
TOKEN_DIGEST_PEPPER=
REAL_NAME_HMAC_KEY=
AUTH_AUDIT_PEPPER=
CAPTCHA_PEPPER=
