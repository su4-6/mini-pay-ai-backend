# Local demo values only. Replace every secret and pepper outside demo-auth.
# --- Local service topology ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=minipay
RABBITMQ_PASSWORD=minipay
SEATA_ENABLED=true
SEATA_SERVER_ADDR=localhost:8091
IDENTITY_INTERNAL_URL=http://localhost:8081
IDENTITY_TOKEN_URL=http://localhost:8081/oauth2/token
WALLET_INTERNAL_URL=http://localhost:8083
WALLET_BASE_URL=http://localhost:8083
PAYMENT_INTERNAL_URL=http://localhost:8082
COMMERCE_INTERNAL_URL=http://localhost:8085
# Local login uses the fixed demo code below and does not print verification codes to logs.
LOCAL_IDENTITY_PROFILES=demo-auth
# --- MySQL (local, not Docker) ---
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
AGENT_DATABASE=minipay_agent
# --- Infrastructure ---
SEATA_DB_PASSWORD=seata
SEATA_CONSOLE_USERNAME=seata
SEATA_CONSOLE_PASSWORD=seata
# --- Session ---
SPRING_SESSION_COOKIE_NAME=minipay-management-dev
IDENTITY_SESSION_COOKIE_NAME=minipay-identity-dev
SESSION_COOKIE_SECURE=false
# --- Email verification code ---
# provider=smtp 且 EMAIL_SMTP_HOST 非空时启用（QQ 邮箱：smtp.qq.com:465/SSL）。
# 密码填 QQ 邮箱「授权码」（设置 → 账号 → 开启 SMTP 后生成），不是 QQ 密码。
EMAIL_PROVIDER=disabled
EMAIL_FROM=
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USERNAME=你的邮箱@qq.com
# EMAIL_SMTP_PASSWORD=你的授权码
# EMAIL_SMTP_AUTH=true
# EMAIL_SMTP_SSL=true
# --- OAuth / Security ---
MANAGEMENT_OAUTH_CLIENT_SECRET=minipay-management-demo-secret
ADMIN_OAUTH_CLIENT_SECRET=minipay-admin-demo-secret
ADMIN_WEB_PUBLIC_URL=http://localhost:8002/
ADMIN_OAUTH_REDIRECT_URI=http://localhost:8089/login/oauth2/code/minipay-admin
# Optional one-time, idempotent bootstrap. Leave empty after the first super admin exists.
BOOTSTRAP_SYSTEM_ADMIN_MOBILE=
BOOTSTRAP_SYSTEM_ADMIN_DISPLAY_NAME=系统超级管理员
PHONE_HASH_PEPPER=minipay-demo-phone-pepper-change-me
PHONE_DISCLOSURE_ENCRYPTION_KEY=minipay-demo-phone-disclosure-key-change-me
PHONE_DISCLOSURE_KEY_ID=v1
EMAIL_HASH_PEPPER=minipay-demo-email-pepper-change-me
TOKEN_DIGEST_PEPPER=minipay-demo-token-pepper-change-me
REAL_NAME_PROVIDER=sandbox
REAL_NAME_HMAC_KEY=minipay-demo-real-name-hmac-key-change-me
AUTH_AUDIT_PEPPER=minipay-demo-audit-pepper-change-me
CAPTCHA_PEPPER=minipay-demo-captcha-pepper-change-me
PAYMENT_TO_IDENTITY_CLIENT_SECRET=minipay-payment-identity-demo-secret
PAYMENT_TO_WALLET_CLIENT_SECRET=minipay-payment-wallet-demo-secret
AGENT_TO_PAYMENT_CLIENT_SECRET=minipay-agent-payment-demo-secret
COMMERCE_TO_IDENTITY_CLIENT_ID=minipay-commerce-to-identity
COMMERCE_TO_IDENTITY_CLIENT_SECRET=minipay-commerce-identity-demo-secret
YSHOP_MINIPAY_HMAC_SECRET=minipay-yshop-local-hmac-secret-change-me
YSHOP_MINIPAY_AVATAR_ALLOWED_HOSTS=localhost,127.0.0.1,minipay-ai.oss-cn-beijing.aliyuncs.com
AGENT_DELEGATION_CLIENT_ID=minipay-agent-service
AGENT_DELEGATION_CLIENT_SECRET=minipay-agent-delegation-demo-secret
IDENTITY_TO_PAYMENT_CLIENT_ID=minipay-identity-to-payment
IDENTITY_TO_PAYMENT_CLIENT_SECRET=minipay-identity-payment-demo-secret
PAYMENT_AUTHORIZATION_TOKEN_KEY=minipay-demo-payment-auth-token-key-change-me
# --- AI model (DeepSeek OpenAI-compatible API) ---
MODEL_ENABLED=true
MODEL_CHAT_MODE=openai
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_MAX_TOKENS=2048
MODEL_THINKING_ENABLED=false
MODEL_REQUEST_TIMEOUT=120s
MODEL_API_KEY=
AGENT_MAX_CONCURRENT_RUNS_PER_USER=3
AGENT_MAX_CONCURRENT_MODEL_CALLS=32
AGENT_RUN_STALE_TIMEOUT=3m
# --- Demo ---
DEMO_SMS_CODE=123456
# 短信渠道：demo=固定验证码123456（默认，免配置）；dypns=阿里云号码认证（真实短信，个人开发者可用）；
#           aliyun=标准短信（需企业资质）；disabled=禁用
# 本地 JVM（IDEA 直接跑）由 application-demo-auth.yml 的 spring.config.import 自动读取本文件；
# docker compose 启动则自动注入容器。两种方式都只认 .env 这一个入口。
SMS_PROVIDER=demo
# ===== 阿里云号码认证（SMS_PROVIDER=dypns 时需要，见下）=====
# AK/SK 在阿里云控制台 → AccessKey 管理 创建；也可改用 ALIYUN_DYPNS_ACCESS_KEY_ID/SECRET（dypns 专属命名，优先级更高）。
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 云侧前置（.env 之外）：阿里云控制台 → 开通「号码认证服务」并申请短信签名（个人开发者可自助），
# 签名在号码认证控制台查看（如：恒创联众）；模板用系统模板 100001；##code## 占位符勿改。
# ALIYUN_DYPNS_SIGN_NAME=
# ALIYUN_DYPNS_TEMPLATE_CODE=100001
# ALIYUN_DYPNS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
# ===== 阿里云 OSS 对象存储（消费者头像 + 商户/店铺图片）=====
# 与短信共用同一套 AK/SK（ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET，见上方阿里云号码认证段）。
# 同时服务 identity-service（头像）和 payment-service（店铺图）。
# 本地 JVM（IDEA 直接跑）由各服务 demo yml 的 spring.config.import 自动读取本文件；
# docker compose 启动则自动注入容器。
# provider=aliyun 且 endpoint/region/bucket 为空时服务会启动失败。
# 云侧前置（.env 之外）：
#   1) RAM 权限：使用的 AK 需要该 Bucket 的 PutObject / GetObject / HeadObject / DeleteObject 权限，
#      否则客户端直传返回 403（表现：App 提示“头像上传已失效”）。
#   2) CORS（仅 Web 端 ops-web 上传店铺图需要）：Bucket → 跨域设置，Origin 填 http://localhost:8000，
#      方法 PUT/GET/HEAD，允许头 Content-Type、x-oss-meta-sha256。App 直传不受 CORS 影响。
OBJECT_STORAGE_PROVIDER=disabled
# 在阿里云 OSS 控制台创建私有 Bucket 后填写以下 3 项（外网访问 Endpoint 形如 oss-cn-beijing.aliyuncs.com）：
# ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# ALIYUN_OSS_REGION=cn-beijing
# ALIYUN_OSS_BUCKET=你的私有Bucket名称
# 如需 OSS 专属 AK/SK（而非复用短信的），设置以下变量（优先级高于 ALIBABA_CLOUD_*）：
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_SECURITY_TOKEN=

# ===== 聊天语音消息与一对一语音通话 =====
# Agent Service 复用上方私有 OSS 配置；请为 chat/voice/* 前缀授予最小权限。
VOICE_UPLOAD_TTL=PT10M
VOICE_READ_TTL=PT5M
VOICE_CALL_RING_TIMEOUT=PT30S
TURN_URLS=stun:stun.l.google.com:19302
# 必须生成随机值并通过 Secret 注入；不要提交真实值。
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=PT1H
JWT_SIGNING_PRIVATE_KEY_LOCATION=
JWT_SIGNING_PUBLIC_KEY_LOCATION=

# Local sandbox bank only. Amounts are Chinese yuan cents.
BANK_SANDBOX_TOKENIZATION_KEY=
BANK_SANDBOX_INITIAL_BALANCE_CENT=10000000
BANK_SANDBOX_SINGLE_PAYMENT_LIMIT_CENT=1000000
BANK_SANDBOX_DAILY_PAYMENT_LIMIT_CENT=5000000
WALLET_TO_IDENTITY_CLIENT_ID=minipay-wallet-to-identity
WALLET_TO_IDENTITY_CLIENT_SECRET=minipay-wallet-identity-demo-secret
COLLECTION_CODE_SIGNING_KEY=local-collection-code-signing-key-change-me
# Required when payment-service provisions a merchant's default application.
# Generate 32 random bytes, encode them as standard Base64, and keep the value stable.
# Never commit the generated value or change it after merchant applications exist.
MERCHANT_APP_SECRET_KEY=
COMMERCE_ADDRESS_ENCRYPTION_KEY=bWluaXBheS1jb21tZXJjZS1kZW1vLWtleS0zMmJ5dGU=
COMMERCE_ADDRESS_ENCRYPTION_KEY_VERSION=1
AGENT_TO_IDENTITY_CLIENT_ID=minipay-agent-to-identity
AGENT_TO_IDENTITY_CLIENT_SECRET=minipay-agent-identity-demo-secret
